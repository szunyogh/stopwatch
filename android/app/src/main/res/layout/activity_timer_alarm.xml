<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_gradient"
    android:padding="32dp"
    tools:theme="@style/Theme.Material3.DayNight.NoActionBar">

    <View
        android:id="@+id/icon_glow"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:background="@drawable/bg_circle_glow"
        app:layout_constraintBottom_toTopOf="@+id/tv_alarm_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <View
        android:id="@+id/pulse_1"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:background="@drawable/bg_pulse_circle"
        app:layout_constraintBottom_toBottomOf="@id/icon_glow"
        app:layout_constraintEnd_toEndOf="@id/icon_glow"
        app:layout_constraintStart_toStartOf="@id/icon_glow"
        app:layout_constraintTop_toTopOf="@id/icon_glow" />

    <View
        android:id="@+id/pulse_2"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:background="@drawable/bg_pulse_circle"
        app:layout_constraintBottom_toBottomOf="@id/icon_glow"
        app:layout_constraintEnd_toEndOf="@id/icon_glow"
        app:layout_constraintStart_toStartOf="@id/icon_glow"
        app:layout_constraintTop_toTopOf="@id/icon_glow" />

    <View
        android:id="@+id/pulse_3"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:background="@drawable/bg_pulse_circle"
        app:layout_constraintBottom_toBottomOf="@id/icon_glow"
        app:layout_constraintEnd_toEndOf="@id/icon_glow"
        app:layout_constraintStart_toStartOf="@id/icon_glow"
        app:layout_constraintTop_toTopOf="@id/icon_glow" />

    <ImageView
        android:id="@+id/iv_alarm_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_stat_timer"
        app:layout_constraintBottom_toBottomOf="@+id/icon_glow"
        app:layout_constraintEnd_toEndOf="@+id/icon_glow"
        app:layout_constraintStart_toStartOf="@+id/icon_glow"
        app:layout_constraintTop_toTopOf="@+id/icon_glow"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/tv_alarm_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="@string/timer_finished_title"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tv_alarm_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/icon_glow" />

    <TextView
        android:id="@+id/tv_alarm_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/timer_finished_body"
        android:textColor="#E0E0E0"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/btn_alarm_stop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_alarm_title" />

    <Button
        android:id="@+id/btn_alarm_stop"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_button"
        android:text="@string/timer_finished_stop"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
