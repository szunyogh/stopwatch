<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:contentDescription="@string/widget_description"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:text="@string/widget_name"
            android:textColor="@color/text_color"
            android:textSize="25sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_toggle_bg"
            android:orientation="horizontal"
            android:padding="3dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_toggle_stopwatch"
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:padding="3dp"
                android:src="@drawable/ic_toggle_stopwatch" />

            <ImageView
                android:id="@+id/widget_toggle_timer"
                android:layout_width="30dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:padding="3dp"
                android:src="@drawable/ic_toggle_timer" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/rounded_image_bg"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/stopwatch_icon"
            tools:targetApi="31" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/widget_time_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/text_color"
        android:textSize="50sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/widget_action_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/rounded_button_start_bg"
        android:elevation="0dp"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:stateListAnimator="@null"
        android:text="@string/widget_button_text_start"
        android:textColor="@color/button_text"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>